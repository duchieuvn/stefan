FROM postgres:16

# Set default environment variables for database initialization
ENV POSTGRES_DB=sensor_data
ENV POSTGRES_USER=postgres
ENV POSTGRES_PASSWORD=root_postgres_password
ENV POSTGRES_INITDB_ARGS="--auth-host=scram-sha-256"

RUN sed -i "s/^#listen_addresses = 'localhost'/listen_addresses = '*'/" /usr/local/share/postgresql/postgresql.conf.sample

COPY pg_hba.conf /etc/postgresql/pg_hba.conf
CMD ["postgres", "-c", "hba_file=/etc/postgresql/pg_hba.conf"]

# Copy the dump file and restore script into the auto-init directory
COPY sensor_data.dump /docker-entrypoint-initdb.d/sensor_data.dump
COPY db_build.sh /docker-entrypoint-initdb.d/01-db_build.sh

# Ensure the entrypoint script is executable
RUN chmod +x /docker-entrypoint-initdb.d/01-db_build.sh

# Expose standard PostgreSQL port
EXPOSE 5432