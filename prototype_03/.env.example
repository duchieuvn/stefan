# Copy this file to .env and replace the values with your PostgreSQL settings.

# PostgreSQL DSN (Data Source Name)
# This is the connection string for the database itself.
# The host/port will be replaced by the SSH tunnel's local endpoint.
RTI_POSTGRES_DSN="postgresql://db_user:db_password@db_host_on_server/sensor_data"

# SSH Tunnel Settings
# These are the credentials to connect to the server where the database is running.
RTI_SSH_HOST="server.example.com"
RTI_SSH_PORT="22"
RTI_SSH_USER="ssh_user"
RTI_SSH_PASSWORD="ssh_password"

# Path to your known_hosts file, usually ~/.ssh/known_hosts
RTI_SSH_KNOWN_HOSTS="~/.ssh/known_hosts"

# PostgreSQL server address as seen from the SSH server
RTI_DB_HOST="127.0.0.1"
RTI_DB_PORT="5432"
