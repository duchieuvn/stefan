# Settings for backend/master on the Server (PROD).
# Every key is required; config.py fails on a missing one.
# Activate on a machine with: ln -s .env.prod .env

# Serial / storage
# Node bus is on the FTDI adapter; by-id path survives ttyUSB renumbering
PORT=/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_A5069RR4-if00-port0
BAUDRATE=9600
# Relative paths resolve against backend/
DATA_DIR=data
DB_FILENAME=sensor_data.db

NODES=1,2,3,4,5,6,7,8

# Register map
CMD_REGISTER=200
CMD_TX=10
CMD_BME=11
CMD_LED_ON=1
CMD_LED_OFF=2

# 300/301: 32-bit TX-Timestamp (ms), wird vom Sender mitgesendet
# und vom Empfänger 1:1 im RX-Block zurückgeliefert
TX_TIMESTAMP_BASE_REG=300

RX_BLOCK_ADDR=100
RX_BLOCK_COUNT=16

BME_TEMP_REG=120
BME_NODES=5,6,7,8

# Payload
PAYLOAD_LEN_REG=320
PAYLOAD_DATA_BASE=321
PAYLOAD_MAX_BYTES=64
PAYLOAD_TEXT="The quick brown fox jumps over the lazy dog"

# Timing
RX_TIMEOUT_S=10.0
RX_POLL_S=0.05
RX_STABLE_READS=2
RX_STABLE_GAP_S=0.03

BME_TIMEOUT_S=3.0
BME_POLL_S=0.2
REQUIRE_BME=false

MEASURE_INTERVAL_S=60.0

# SQLite robustness
SQLITE_CONNECT_TIMEOUT_S=30.0
SQLITE_BUSY_TIMEOUT_MS=15000
COMMIT_RETRIES=12
COMMIT_BACKOFF_START_S=0.15
COMMIT_BACKOFF_MAX_S=2.0

# LoRa config registers
# 400..404 = freq_x10, power, sf, bw, cr
LORA_BASE=400
LORA_APPLY=410

# LoRa defaults
DEFAULT_FREQ_MHZ=433.0
DEFAULT_POWER=22
DEFAULT_SF=12
DEFAULT_BW=125
DEFAULT_CR=8

# Terminal logging
VERBOSE=true
PRINT_LINK_LINE=true

# Firmware update (OTA): own serial port, firmware URL (one .bin for all nodes),
# max. time per node for WiFi + download + flash + reboot
OTA_PORT=/dev/ttyUSB1
OTA_URL=https://github.com/duchieuvn/stefan/releases/latest/download/slave.bin
OTA_NODE_TIMEOUT_S=300
