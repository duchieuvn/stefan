RTI_DB_BACKEND=postgres

# PostgreSQL credentials. The SSH tunnel overrides host and port locally.
RTI_POSTGRES_DSN=postgresql://holzofen:biofilter@localhost:5432/sensor_data
# Direct PostgreSQL endpoint reachable over Tailscale, without an SSH tunnel.
RTI_TAILSCALE_POSTGRES_DSN=postgresql://holzofen:biofilter@100.100.51.120:5432/reduced_data
# SSH bastion/server and authenticated user.
RTI_SSH_HOST=10.10.64.27
RTI_SSH_PORT=22
RTI_SSH_USER=holzofen
RTI_SSH_PASSWORD=biofilter
RTI_SSH_KNOWN_HOSTS=/home/duchieuvn/.ssh/known_hosts

# PostgreSQL endpoint as reachable from the SSH server.
RTI_DB_HOST=127.0.0.1
RTI_DB_PORT=5432
RTI_DB_CONNECT_TIMEOUT_S=60
# Upper bound for one query (the aggregate over all history months).
RTI_DB_STATEMENT_TIMEOUT_S=600

RTI_SQLITE_REMOTE_PATH=/home/holzofen/Schreibtisch/prototype_01/reduce_sqlite/backup.db
